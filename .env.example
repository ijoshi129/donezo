# Copy this file to ".env" and fill it in to enable Apple Reminders → Donezo sync.
# The real .env is git-ignored so your password is never committed.
#
# Use an app-specific password from account.apple.com
# (Sign-In & Security → App-Specific Passwords) — NOT your real Apple ID password.

ICLOUD_USER=you@icloud.com
ICLOUD_APP_PASSWORD=abcd-efgh-ijkl-mnop

ICLOUD_LIST=Donezo          # the Reminders list to watch
ICLOUD_AFTER_IMPORT=keep    # keep | complete | delete
# ICLOUD_POLL_SECONDS=60

# ── macOS Reminders watcher (recommended for iCloud) ──
# If Donezo runs on a Mac, this reads the Reminders list directly via AppleScript
# (sees iCloud reminders that CalDAV can't) and imports new ones near-instantly.
# Grant the one-time "control Reminders" prompt on first run. macOS only.
MAC_REMINDERS_LIST=Donezo        # the Reminders list to watch (leave unset to disable)
MAC_REMINDERS_POLL_SECONDS=15
MAC_REMINDERS_AFTER=complete     # complete | delete

# ── Bridge mode (Donezo runs elsewhere, e.g. Docker on Linux) ──
# Run `node mac-reminders-bridge.js` ON A MAC to read Reminders and POST them to
# a remote Donezo. Set DONEZO_URL to that server (and MAC_REMINDERS_LIST above).
# DONEZO_URL=http://192.168.1.83:4173
